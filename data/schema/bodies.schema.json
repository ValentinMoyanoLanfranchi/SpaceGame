{
  "$defs": {
    "Body": {
      "additionalProperties": false,
      "description": "Cuerpo celeste (entrada de `bodies.json`, doc 22 §1.1 y §11). Sólo `star` puede no tener\n`parent`.\n\nDeserializarlo comprueba la forma; los rangos y la regla del padre, [`Body::validate`] (el\ncargador la llama por cada entrada).",
      "else": {
        "properties": {
          "parent": {
            "type": "string"
          }
        },
        "required": [
          "parent"
        ]
      },
      "if": {
        "properties": {
          "kind": {
            "const": "star"
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "deposits": {
          "description": "Yacimientos.",
          "items": {
            "$ref": "#/$defs/Deposit"
          },
          "type": "array"
        },
        "detect_difficulty": {
          "description": "Dificultad de detección por telescopio (0–10).",
          "format": "uint8",
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "habitability": {
          "default": null,
          "description": "Habitabilidad (0–1); ausente si no aplica.",
          "format": "double",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "description": "Id de texto (`body.*`).",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BodyKind",
          "description": "Tipo de cuerpo."
        },
        "mass_kg": {
          "description": "Masa, en kg (mayor que 0); la usa la vista con rangos (doc 22 §1.3).",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "orbit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Orbit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Órbita; ausente para la estrella."
        },
        "parent": {
          "default": null,
          "description": "Id del cuerpo padre; sólo puede faltar en una estrella.",
          "type": [
            "string",
            "null"
          ]
        },
        "radius_km": {
          "description": "Radio del cuerpo, en km (mayor que 0).",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "radius_km",
        "mass_kg",
        "detect_difficulty"
      ],
      "type": "object"
    },
    "BodyKind": {
      "description": "Tipo de cuerpo (`kind` en `bodies.json`).",
      "oneOf": [
        {
          "const": "star",
          "description": "Estrella: el único tipo que puede no tener padre.",
          "type": "string"
        },
        {
          "const": "planet",
          "description": "Planeta rocoso.",
          "type": "string"
        },
        {
          "const": "dwarf_planet",
          "description": "Planeta enano.",
          "type": "string"
        },
        {
          "const": "moon",
          "description": "Luna.",
          "type": "string"
        },
        {
          "const": "asteroid",
          "description": "Asteroide.",
          "type": "string"
        },
        {
          "const": "gas_giant",
          "description": "Gigante gaseoso.",
          "type": "string"
        }
      ]
    },
    "Deposit": {
      "additionalProperties": false,
      "description": "Yacimiento de un cuerpo (`deposits[]` en `bodies.json`).",
      "properties": {
        "access": {
          "description": "Facilidad de acceso (0–1).",
          "format": "double",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "good": {
          "description": "Id de texto del bien (`good.*`).",
          "type": "string"
        },
        "reserve_mt": {
          "description": "Reserva, en megatoneladas (mayor que 0).",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "good",
        "reserve_mt",
        "access"
      ],
      "type": "object"
    },
    "Orbit": {
      "additionalProperties": false,
      "description": "Órbita circular de un cuerpo. El radio va en `radius_au` o en `radius_km` (exactamente uno).",
      "oneOf": [
        {
          "properties": {
            "radius_au": {
              "type": "number"
            }
          },
          "required": [
            "radius_au"
          ]
        },
        {
          "properties": {
            "radius_km": {
              "type": "number"
            }
          },
          "required": [
            "radius_km"
          ]
        }
      ],
      "properties": {
        "period_days": {
          "description": "Período, en días.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "radius_au": {
          "default": null,
          "description": "Radio orbital, en UA (órbitas heliocéntricas).",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "radius_km": {
          "default": null,
          "description": "Radio orbital, en km (lunas).",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/OrbitKind",
          "description": "Tipo de órbita."
        }
      },
      "required": [
        "type",
        "period_days"
      ],
      "type": "object"
    },
    "OrbitKind": {
      "description": "Forma de órbita de un cuerpo. El MVP sólo usa órbitas circulares (doc 22 §0).",
      "oneOf": [
        {
          "const": "circular",
          "description": "Circular y coplanar (`e = 0`).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/Body"
  },
  "title": "Array_of_Body",
  "type": "array"
}
